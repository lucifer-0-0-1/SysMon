# Maintainer: lucifer-0-0-1 <amritam.leon@gmail.com>
pkgname=laptop-monitor
pkgver=1.2.0
pkgrel=1
pkgdesc="Lightweight laptop monitor: temperatures, usage, GPU, battery, processes and PWM fan control"
arch=('any')
url="https://github.com/lucifer-0-0-1/SysMon"
license=('Apache-2.0')
depends=('python' 'python-psutil' 'python-dotenv' 'pyside6')
optdepends=('polkit: fan control without sudo'
            'nvidia-utils: NVIDIA GPU usage, power and VRAM stats'
            'libnotify: desktop alerts for high temperature and low battery')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a95b7fd04359e0eaffd82c0c24d9954f3df17e6ece13caa3f80de783ba098a48')

package() {
  cd "SysMon-$pkgver"
  packaging/install-files.sh "$pkgdir"
  python -m compileall -q -d "/usr/share/$pkgname" "$pkgdir/usr/share/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
