# Copy to ~/.config/laptop-monitor/config.env (or ./.env when running from source).
# The Settings tab writes this file for you.
UPDATE_INTERVAL=1000          # refresh period, milliseconds
MAX_HISTORY_POINTS=120        # samples shown in dashboard graphs
CPU_TEMP_THRESHOLD=90.0       # desktop alert above this (Celsius)
GPU_TEMP_THRESHOLD=85.0
BATTERY_LOW_PERCENT=15
NOTIFICATIONS=true            # needs notify-send (libnotify)
GPU_POLL_SECONDS=10           # nvidia-smi period; keep above the dGPU autosuspend delay
WINDOW_WIDTH=1000
WINDOW_HEIGHT=700
PLUGINS_ENABLED=true
