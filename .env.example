# Environment variables for Laptop Monitor
# Copy this file to .env and modify as needed

# Application settings
UPDATE_INTERVAL=2000                  # Update interval in milliseconds
MAX_HISTORY_POINTS=50                # Maximum data points to keep in graphs

# Fan control settings
AUTO_MODE_ENABLED=false              # Enable automatic fan control based on temperature
CPU_TEMP_THRESHOLD=75.0              # CPU temperature threshold for auto mode (Celsius)
GPU_TEMP_THRESHOLD=80.0              # GPU temperature threshold for auto mode (Celsius)
FAN_MIN_SPEED=30                     # Minimum fan speed (0-255)
FAN_MAX_SPEED=255                    # Maximum fan speed (0-255)

# Monitoring settings
SHOW_GPU_MONITORING=true             # Show GPU monitoring in GUI
SHOW_MEMORY_MONITORING=true          # Show memory monitoring in GUI
SHOW_DISK_MONITORING=true            # Show disk monitoring in GUI
SHOW_NETWORK_MONITORING=false        # Show network monitoring in GUI

# GUI settings
WINDOW_WIDTH=800                     # Application window width
WINDOW_HEIGHT=600                    # Application window height
THEME=default                        # GUI theme (default, clam, alt, classic)

# Plugin settings
PLUGINS_ENABLED=true                 # Enable plugin system
PLUGINS_DIRECTORY=./plugins          # Directory for user plugins